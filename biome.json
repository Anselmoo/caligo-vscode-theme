{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.serena",
      "!**/build",
      "!**/themes",
      "!src/lib/__fixtures__/vscode-colors.json",
      "!**/test-results",
      "!**/coverage",
      "!**/public",
      "!**/.vscode-test",
      "!.claude",
      "!.werkplan"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "formatWithErrors": false
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noUnusedTemplateLiteral": "warn",
        "useTemplate": "warn"
      },
      "suspicious": {
        "noConsole": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.md", "**/*.yml", "**/*.yaml", "**/*.svg"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": ["tests/e2e/**"],
      "linter": {
        "rules": {
          "correctness": {
            "usePlaywrightValidDescribeCallback": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noInvalidGridAreas": "off"
          },
          "a11y": {
            "noNoninteractiveElementToInteractiveRole": "warn",
            "noNoninteractiveTabindex": "warn",
            "noStaticElementInteractions": "warn",
            "noSvgWithoutTitle": "warn",
            "useFocusableInteractive": "warn",
            "useKeyWithClickEvents": "warn",
            "useSemanticElements": "warn"
          }
        }
      }
    }
  ],
  "html": {
    "experimentalFullSupportEnabled": true
  }
}
