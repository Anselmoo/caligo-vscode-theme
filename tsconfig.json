{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "build",
    "rootDir": "src",
    "baseUrl": ".",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "typeRoots": ["src/types", "node_modules/@types"],
    "paths": {
      "@/*": ["src/vue-app/*"],
      "@types/*": ["src/vue-app/types/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "5.0"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "build",
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "src/**/*.spec.ts"
  ]
}
